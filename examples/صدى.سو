استورد "تلجرام_بوت"

خل البوت = تلجرام_بوت.بوت(بيئة("TELEGRAM_BOT_TOKEN"))
خل موجه = تلجرام_بوت.موجّه()
خل مخزن = تلجرام_بوت.جلسات("./جلسات.json")
موجه.استخدم(مخزن.وسيط())

موجه.عند_امر("start", دالة(رسالة, تحديث, ب) {
  خل لوحة = تلجرام_بوت.لوحة_ضمنية([
    [تلجرام_بوت.زر_استدعاء("اختبر الزر", "اختبار")],
    [تلجرام_بوت.زر_رابط("توثيق Telegram", "https://core.telegram.org/bots/api")]
  ])
  ب.رسالة(رسالة.chat.id, "أهلًا! أرسل أي نص وسأعيده لك.", {"reply_markup": لوحة})
  تحديث.session["حالة"] = "صدى"
})

موجه.عند_زر(دالة(زر, تحديث, ب) {
  ب.اجابة_زر(زر.id, "وصل الضغط: " + زر.data)
})

موجه.عند_نص(دالة(رسالة, تحديث, ب) {
  اذا رسالة.text.يبدأ_ب("/") { ارجع }
  اذا تحديث.session.احصل("حالة", عدم) != "صدى" { ارجع }
  ب.رد(رسالة, "وصلني: " + رسالة.text)
})

اطبع("بدأ البوت. أوقفه عبر إنهاء العملية.")
موجه.تشغيل(البوت)
