استورد "شبكة"
استورد "جيسون"
استورد "زمن"
استورد "ملفات"
استورد "نمط"

دالة _دمج(أ, ب) {
  خل ن = {}
  لكل مفتاح, قيمة في أ { ن[مفتاح] = قيمة }
  لكل مفتاح, قيمة في ب { ن[مفتاح] = قيمة }
  ارجع ن
}
دالة _نص_حقل(قيمة) {
  اذا هل_نص(قيمة) { ارجع قيمة }
  خل ن = نوع(قيمة)
  اذا ن == "منطقي" { ارجع قيمة ؟ "true" : "false" }
  اذا ن == "قاموس" او ن == "قائمة" { ارجع جيسون.ترميز(قيمة) }
  ارجع نص(قيمة)
}

// عميل عام. تتيح طلب() استدعاء أي طريقة في Bot API، بما فيها الطرق التي
// تضاف مستقبلاً، بينما توفر بقية الدوال أسماء عربية مختصرة للطرق الشائعة.
صنف خطأ_تلجرام {
  بناء(رسالة, رمز = 0, وصف = "", تفاصيل = عدم) {
    هذا.رسالة = رسالة
    هذا.رمز = رمز
    هذا.وصف = وصف
    هذا.تفاصيل = تفاصيل
    هذا.تجاوز_المعدل = رمز == 429
    هذا.اعادة_بعد = تفاصيل == عدم ؟ 0 : تفاصيل.احصل("retry_after", 0)
  }
  الى_نص() { ارجع هذا.رسالة }
}

صنف بوت {
  بناء(رمز, خيارات = {}) {
    اذا ليس هل_نص(رمز) او رمز == "" { ارمي "رمز بوت Telegram مطلوب" }
    هذا.الرمز = رمز
    هذا.الاساس = خيارات.احصل("عنوان_api", "https://api.telegram.org")
    طالما هذا.الاساس.ينتهي_ب("/") { هذا.الاساس = هذا.الاساس.جزء(0, طول(هذا.الاساس) - 1) }
    هذا.مهلة = خيارات.احصل("مهلة", 70)
    هذا.تحقق_tls = خيارات.احصل("تحقق_tls", صح)
    هذا.محاولات_429 = خيارات.احصل("محاولات_429", 0)
    هذا.الترويسات = خيارات.احصل("رؤوس", {})
    هذا.الناقل = خيارات.احصل("ناقل", عدم)
    هذا.توقف = غلط
  }

  _جلب(رابط, خيارات) {
    اذا هذا.الناقل != عدم { ارجع هذا.الناقل(رابط, خيارات) }
    ارجع شبكة.جلب(رابط, خيارات)
  }

  طلب(طريقة, معطيات = {}) {
    اذا ليس هل_نص(طريقة) او طريقة == "" { ارمي "اسم طريقة Bot API مطلوب" }
    خل خيارات = {
      "طريقة": "POST",
      "مهلة": هذا.مهلة,
      "تحقق": هذا.تحقق_tls,
      "رؤوس": _دمج(هذا.الترويسات, {"Content-Type": "application/json"}),
      "جسم": جيسون.ترميز(معطيات)
    }
    خل محاولة = 0
    طالما صح {
      خل رد
      حاول { رد = هذا._جلب(هذا.الاساس + "/bot" + هذا.الرمز + "/" + طريقة, خيارات) }
      امسك (خ) { ارمي خطأ_تلجرام("تعذّر الاتصال بـ Telegram في " + طريقة + ": " + نص(خ), 0, نص(خ)) }
      خل جسم
      حاول { جسم = جيسون.فك(رد.جسم) }
      امسك (خ) { ارمي خطأ_تلجرام("رد غير صالح من Telegram (HTTP " + نص(رد.حالة) + ")", رد.حالة, رد.جسم) }
      اذا جسم.احصل("ok", غلط) == صح { ارجع جسم.احصل("result", عدم) }
      خل وصف = جسم.احصل("description", "طلب Telegram فشل")
      خل رمز = جسم.احصل("error_code", رد.حالة)
      خل تفاصيل = جسم.احصل("parameters", عدم)
      // إعادة المحاولة محدودة افتراضيًا إلى صفر، ولا تحدث إلا مع 429 صريح.
      // لا نعيد المحاولة تلقائيًا عند مهلة شبكة لاحتمال أن يكون Telegram نفّذ POST بالفعل.
      اذا رمز == 429 و محاولة < هذا.محاولات_429 {
        محاولة += 1
        زمن.نوم(تفاصيل == عدم ؟ 1 : تفاصيل.احصل("retry_after", 1))
        استمر
      }
      ارمي خطأ_تلجرام("Telegram " + نص(رمز) + ": " + وصف, رمز, وصف, تفاصيل)
    }
  }

  طلب_ملفات(طريقة, معطيات = {}, ملفات = {}) {
    خل نموذج = {}
    لكل مفتاح, قيمة في معطيات { نموذج[مفتاح] = _نص_حقل(قيمة) }
    لكل مفتاح, ملف في ملفات {
      اذا هل_نص(ملف) { نموذج[مفتاح] = {"ملف": ملف} }
      والا { نموذج[مفتاح] = ملف }
    }
    خل محاولة = 0
    طالما صح {
      خل رد
      حاول { رد = هذا._جلب(هذا.الاساس + "/bot" + هذا.الرمز + "/" + طريقة, {"طريقة": "POST", "مهلة": هذا.مهلة, "تحقق": هذا.تحقق_tls, "نموذج": نموذج}) }
      امسك (خ) { ارمي خطأ_تلجرام("تعذّر رفع الملف عبر " + طريقة + ": " + نص(خ), 0, نص(خ)) }
      خل جسم
      حاول { جسم = جيسون.فك(رد.جسم) }
      امسك (خ) { ارمي خطأ_تلجرام("رد رفع غير صالح من Telegram (HTTP " + نص(رد.حالة) + ")", رد.حالة, رد.جسم) }
      اذا جسم.احصل("ok", غلط) == صح { ارجع جسم.احصل("result", عدم) }
      خل رمز = جسم.احصل("error_code", رد.حالة)
      خل وصف = جسم.احصل("description", "فشل رفع الملف")
      خل تفاصيل = جسم.احصل("parameters", عدم)
      اذا رمز == 429 و محاولة < هذا.محاولات_429 {
        محاولة += 1
        زمن.نوم(تفاصيل == عدم ؟ 1 : تفاصيل.احصل("retry_after", 1))
        استمر
      }
      ارمي خطأ_تلجرام("Telegram " + نص(رمز) + ": " + وصف, رمز, وصف, تفاصيل)
    }
  }

  معلومات() { ارجع هذا.طلب("getMe") }
  get_me() { ارجع هذا.معلومات() }
  رسالة(معرف_محادثة, نص_الرسالة, خيارات = {}) { ارجع هذا.طلب("sendMessage", _دمج(خيارات, {"chat_id": معرف_محادثة, "text": نص_الرسالة})) }
  ارسل_رسالة(معرف_محادثة, نص_الرسالة, خيارات = {}) { ارجع هذا.رسالة(معرف_محادثة, نص_الرسالة, خيارات) }
  رد(رسالة, نص_الرد, خيارات = {}) {
    خل محادثة = رسالة.احصل("chat", {}).احصل("id", عدم)
    خل رد_على = رسالة.احصل("message_id", عدم)
    اذا محادثة == عدم { ارمي "الرسالة لا تحتوي chat.id" }
    ارجع هذا.رسالة(محادثة, نص_الرد, _دمج(خيارات, {"reply_parameters": {"message_id": رد_على}}))
  }
  تعديل_رسالة(معرف_محادثة, معرف_رسالة, نص_الرسالة, خيارات = {}) { ارجع هذا.طلب("editMessageText", _دمج(خيارات, {"chat_id": معرف_محادثة, "message_id": معرف_رسالة, "text": نص_الرسالة})) }
  حذف_رسالة(معرف_محادثة, معرف_رسالة) { ارجع هذا.طلب("deleteMessage", {"chat_id": معرف_محادثة, "message_id": معرف_رسالة}) }
  صورة(معرف_محادثة, صورة, خيارات = {}) { ارجع هذا.طلب("sendPhoto", _دمج(خيارات, {"chat_id": معرف_محادثة, "photo": صورة})) }
  ملف(معرف_محادثة, ملف, خيارات = {}) { ارجع هذا.طلب("sendDocument", _دمج(خيارات, {"chat_id": معرف_محادثة, "document": ملف})) }
  رفع_صورة(معرف_محادثة, مسار, خيارات = {}) { ارجع هذا.طلب_ملفات("sendPhoto", _دمج(خيارات, {"chat_id": معرف_محادثة}), {"photo": مسار}) }
  رفع_ملف(معرف_محادثة, مسار, خيارات = {}) { ارجع هذا.طلب_ملفات("sendDocument", _دمج(خيارات, {"chat_id": معرف_محادثة}), {"document": مسار}) }
  صوت(معرف_محادثة, مسار_او_معرف, خيارات = {}) { ارجع هذا.طلب("sendAudio", _دمج(خيارات, {"chat_id": معرف_محادثة, "audio": مسار_او_معرف})) }
  فيديو(معرف_محادثة, مسار_او_معرف, خيارات = {}) { ارجع هذا.طلب("sendVideo", _دمج(خيارات, {"chat_id": معرف_محادثة, "video": مسار_او_معرف})) }
  موقع(معرف_محادثة, خط_عرض, خط_طول, خيارات = {}) { ارجع هذا.طلب("sendLocation", _دمج(خيارات, {"chat_id": معرف_محادثة, "latitude": خط_عرض, "longitude": خط_طول})) }
  فعل_كتابة(معرف_محادثة, فعل = "typing", خيارات = {}) { ارجع هذا.طلب("sendChatAction", _دمج(خيارات, {"chat_id": معرف_محادثة, "action": فعل})) }
  اجابة_زر(معرف_استعلام, نص_الاجابة = "", خيارات = {}) { ارجع هذا.طلب("answerCallbackQuery", _دمج(خيارات, {"callback_query_id": معرف_استعلام, "text": نص_الاجابة})) }
  اجابة_استعلام(معرف_استعلام, نتائج, خيارات = {}) { ارجع هذا.طلب("answerInlineQuery", _دمج(خيارات, {"inline_query_id": معرف_استعلام, "results": نتائج})) }
  استعلامات(خيارات = {}) { ارجع هذا.طلب("getUpdates", خيارات) }
  ويبهوك(رابط, خيارات = {}) { ارجع هذا.طلب("setWebhook", _دمج(خيارات, {"url": رابط})) }
  حذف_ويبهوك(خيارات = {}) { ارجع هذا.طلب("deleteWebhook", خيارات) }
  حالة_ويبهوك() { ارجع هذا.طلب("getWebhookInfo") }
  خادم_ويبهوك(منفذ, موجّه_تحديثات, خيارات = {}) {
    خل المسار = خيارات.احصل("مسار", "/telegram/webhook")
    خل السر = خيارات.احصل("سر", "")
    خل إعدادات = {"عنوان": خيارات.احصل("عنوان", "0.0.0.0")}
    اذا خيارات.احصل("شهادة", عدم) != عدم { إعدادات["شهادة"] = خيارات["شهادة"] }
    اذا خيارات.احصل("مفتاح", عدم) != عدم { إعدادات["مفتاح"] = خيارات["مفتاح"] }
    اذا خيارات.احصل("عمليات", عدم) != عدم { إعدادات["عمليات"] = خيارات["عمليات"] }
    خل البوت_الحالي = هذا
    ارجع شبكة.خادم(منفذ, دالة(طلب_وارد) {
      اذا طلب_وارد.طريقة != "POST" او طلب_وارد.مسار != المسار { ارجع {"حالة": 404, "جسم": "غير موجود"} }
      اذا السر != "" و طلب_وارد.رؤوس.احصل("x-telegram-bot-api-secret-token", "") != السر { ارجع {"حالة": 403, "جسم": "مرفوض"} }
      خل تحديث
      حاول { تحديث = جيسون.فك(طلب_وارد.جسم) }
      امسك (خ) { ارجع {"حالة": 400, "جسم": "JSON غير صالح"} }
      موجّه_تحديثات.معالجة(تحديث, البوت_الحالي)
      ارجع {"حالة": 200, "جسم": "OK"}
    }, إعدادات)
  }
  هل_مشرف(معرف_محادثة, معرف_مستخدم) {
    خل عضو = هذا.طلب("getChatMember", {"chat_id": معرف_محادثة, "user_id": معرف_مستخدم})
    ارجع عضو.احصل("status", "") == "creator" او عضو.احصل("status", "") == "administrator"
  }
  رابط_ملف(معرف_ملف) {
    خل معلومات = هذا.طلب("getFile", {"file_id": معرف_ملف})
    ارجع هذا.الاساس + "/file/bot" + هذا.الرمز + "/" + معلومات["file_path"]
  }
  تنزيل_ملف(معرف_ملف, مسار) {
    خل رد = شبكة.جلب(هذا.رابط_ملف(معرف_ملف), {"مهلة": هذا.مهلة, "تحقق": هذا.تحقق_tls})
    اذا ليس رد.ناجح { ارمي "فشل تنزيل الملف: HTTP " + نص(رد.حالة) }
    ملفات.اكتب(مسار, رد.جسم)
    ارجع مسار
  }
  ايقاف() { هذا.توقف = صح }

  // long polling. يحتفظ بالـ offset بعد كل تحديث لتجنب إعادة معالجته.
  استطلاع(معالج, خيارات = {}) {
    هذا.توقف = غلط
    خل تعويض = خيارات.احصل("offset", 0)
    خل مهلة_الاستطلاع = خيارات.احصل("timeout", 30)
    خل الانواع = خيارات.احصل("allowed_updates", عدم)
    خل اساس_التأخير = خيارات.احصل("تأخير_الخطأ", 1)
    خل حد_التأخير = خيارات.احصل("حد_التأخير", 30)
    خل التأخير = اساس_التأخير
    طالما ليس هذا.توقف {
      حاول {
        خل م = {"offset": تعويض, "timeout": مهلة_الاستطلاع}
        اذا الانواع != عدم { م["allowed_updates"] = الانواع }
        خل دفعة = هذا.استعلامات(م)
        التأخير = اساس_التأخير
        لكل تحديث في دفعة {
          اذا تحديث.احصل("update_id", عدم) != عدم { تعويض = تحديث["update_id"] + 1 }
          حاول { معالج(تحديث, هذا) } امسك (خ) { اذا خيارات.احصل("عند_خطأ", عدم) != عدم { خيارات["عند_خطأ"](خ, تحديث, هذا) } والا { اطبع("خطأ معالج التحديث: " + نص(خ)) } }
        }
      } امسك (خ) {
        اذا خيارات.احصل("عند_خطأ", عدم) != عدم { خيارات["عند_خطأ"](خ, عدم, هذا) }
        زمن.نوم(التأخير)
        التأخير = التأخير * 2
        اذا التأخير > حد_التأخير { التأخير = حد_التأخير }
      }
    }
  }
}

// توجيه الرسائل والتحديثات. المعالج يستقبل (التحديث الجزئي، التحديث الكامل، البوت).
صنف موجّه {
  بناء() { هذا.المعالجات = []; هذا.الوسيطات = []; هذا.الرقم = 0; هذا.توقف = غلط; هذا.معالج_الخطأ = عدم }
  استخدم(وسيط) { هذا.الوسيطات.اضف(وسيط); ارجع هذا }
  عند_خطأ(معالج) { هذا.معالج_الخطأ = معالج; ارجع هذا }
  عند(نوع, شرط, معالج) {
    خل مجموعة = "فردي_" + نص(هذا.الرقم)
    هذا.الرقم += 1
    ارجع هذا.عند_في_مجموعة(مجموعة, نوع, شرط, معالج)
  }
  عند_في_مجموعة(مجموعة, نوع, شرط, معالج) {
    هذا.المعالجات.اضف({"مجموعة": مجموعة, "نوع": نوع, "شرط": شرط, "معالج": معالج})
    ارجع هذا
  }
  عند_كل(معالج) { ارجع هذا.عند("كل", دالة(جزء) { ارجع صح }, معالج) }
  عند_رسالة(معالج) { ارجع هذا.عند("message", دالة(جزء) { ارجع صح }, معالج) }
  عند_نص(معالج) { ارجع هذا.عند("message", دالة(جزء) { ارجع جزء.احصل("text", عدم) != عدم }, معالج) }
  عند_صورة(معالج) { ارجع هذا.عند("message", دالة(جزء) { ارجع جزء.احصل("photo", عدم) != عدم }, معالج) }
  عند_نمط(نمط_نصي, معالج, خيارات = {}) {
    ارجع هذا.عند("message", دالة(رسالة) { ارجع رسالة.احصل("text", عدم) != عدم و نمط.هل(نمط_نصي, رسالة.احصل("text", ""), خيارات) }, معالج)
  }
  عند_امر(اسم, معالج) {
    اذا ليس اسم.يبدأ_ب("/") { اسم = "/" + اسم }
    ارجع هذا.عند("message", دالة(رسالة) {
      خل نص_الرسالة = رسالة.احصل("text", "")
      خل اول = نص_الرسالة.قسم(" ")[0].قسم("@")[0]
      ارجع اول == اسم
    }, معالج)
  }
  عند_زر(معالج) { ارجع هذا.عند("callback_query", دالة(جزء) { ارجع صح }, معالج) }
  عند_استعلام_مضمن(معالج) { ارجع هذا.عند("inline_query", دالة(جزء) { ارجع صح }, معالج) }
  عند_قبل_الدفع(معالج) { ارجع هذا.عند("pre_checkout_query", دالة(جزء) { ارجع صح }, معالج) }
  عند_الشحن(معالج) { ارجع هذا.عند("shipping_query", دالة(جزء) { ارجع صح }, معالج) }
  عند_تعديل(معالج) { ارجع هذا.عند("edited_message", دالة(جزء) { ارجع صح }, معالج) }
  عند_منشور(معالج) { ارجع هذا.عند("channel_post", دالة(جزء) { ارجع صح }, معالج) }
  عند_تفاعل(معالج) { ارجع هذا.عند("message_reaction", دالة(جزء) { ارجع صح }, معالج) }
  عند_عضوية(معالج) { ارجع هذا.عند("my_chat_member", دالة(جزء) { ارجع صح }, معالج) }
  عند_استطلاع(معالج) { ارجع هذا.عند("poll", دالة(جزء) { ارجع صح }, معالج) }
  عند_ويب_اب(معالج) { ارجع هذا.عند("message", دالة(رسالة) { ارجع رسالة.احصل("web_app_data", عدم) != عدم }, معالج) }
  _جزء(تحديث, نوع) {
    اذا نوع == "message" { ارجع تحديث.احصل("message", عدم) }
    اذا نوع == "callback_query" { ارجع تحديث.احصل("callback_query", عدم) }
    اذا نوع == "inline_query" { ارجع تحديث.احصل("inline_query", عدم) }
    اذا نوع == "edited_message" { ارجع تحديث.احصل("edited_message", عدم) }
    اذا نوع == "channel_post" { ارجع تحديث.احصل("channel_post", عدم) }
    ارجع تحديث.احصل(نوع, عدم)
  }
  عند_نوع(نوع, معالج) { ارجع هذا.عند(نوع, دالة(جزء) { ارجع صح }, معالج) }
  _توزيع(تحديث, بوت) {
    خل مجموعات_منفذة = {}
    لكل تسجيل في هذا.المعالجات {
      اذا مجموعات_منفذة.احصل(تسجيل["مجموعة"], غلط) { استمر }
      خل جزء = تسجيل["نوع"] == "كل" ؟ تحديث : هذا._جزء(تحديث, تسجيل["نوع"])
      اذا جزء != عدم و تسجيل["شرط"](جزء) {
        مجموعات_منفذة[تسجيل["مجموعة"]] = صح
        تسجيل["معالج"](جزء, تحديث, بوت)
        اذا هذا.توقف { ارجع }
      }
    }
  }
  _وسيط(فهرس, تحديث, بوت) {
    اذا فهرس >= طول(هذا.الوسيطات) { ارجع هذا._توزيع(تحديث, بوت) }
    خل م = هذا
    خل استدعي_التالي = غلط
    خل التالي = دالة() {
      اذا استدعي_التالي { ارمي "استدعاء next() مرتين في middleware واحد" }
      استدعي_التالي = صح
      ارجع م._وسيط(فهرس + 1, تحديث, بوت)
    }
    ارجع هذا.الوسيطات[فهرس](تحديث, بوت, التالي)
  }
  معالجة(تحديث, بوت) {
    هذا.توقف = غلط
    حاول { ارجع هذا._وسيط(0, تحديث, بوت) }
    امسك (خ) {
      اذا هذا.معالج_الخطأ != عدم { ارجع هذا.معالج_الخطأ(خ, تحديث, بوت) }
      ارمي خ
    }
  }
  ايقاف_التوجيه() { هذا.توقف = صح }
  تشغيل(بوت, خيارات = {}) {
    خل م = هذا
    ارجع بوت.استطلاع(دالة(تحديث, ب) { ارجع م.معالجة(تحديث, ب) }, خيارات)
  }
}

دالة مرشح_و(أ, ب) { ارجع دالة(قيمة) { ارجع أ(قيمة) و ب(قيمة) } }
دالة مرشح_او(أ, ب) { ارجع دالة(قيمة) { ارجع أ(قيمة) او ب(قيمة) } }
دالة مرشح_ليس(أ) { ارجع دالة(قيمة) { ارجع ليس أ(قيمة) } }

// مخزن حالة اختياري: ذاكرة فقط إن لم يمرر مسار، أو JSON محفوظ عند التمرير.
صنف جلسات {
  بناء(مسار = "") {
    هذا.المسار = مسار
    هذا.السجلات = {}
    اذا مسار != "" و ملفات.موجود(مسار) {
      حاول { هذا.السجلات = جيسون.فك(ملفات.اقرا(مسار)) }
      امسك (خ) { ارمي "ملف الجلسات غير صالح: " + مسار + "؛ " + نص(خ) }
    }
  }
  _هويات(تحديث) {
    خل مصدر = تحديث.احصل("message", عدم)
    اذا مصدر == عدم { مصدر = تحديث.احصل("edited_message", عدم) }
    اذا مصدر == عدم { مصدر = تحديث.احصل("channel_post", عدم) }
    اذا مصدر == عدم { مصدر = تحديث.احصل("callback_query", عدم) }
    اذا مصدر == عدم { مصدر = تحديث.احصل("inline_query", عدم) }
    اذا مصدر == عدم { مصدر = تحديث.احصل("business_message", عدم) }
    اذا مصدر == عدم { مصدر = تحديث }
    خل المستخدم = مصدر.احصل("from", {}).احصل("id", عدم)
    خل المحادثة = مصدر.احصل("chat", {}).احصل("id", عدم)
    اذا المحادثة == عدم { المحادثة = مصدر.احصل("message", {}).احصل("chat", {}).احصل("id", عدم) }
    ارجع {"مستخدم": المستخدم, "محادثة": المحادثة}
  }
  _مفتاح(تحديث, نطاق = "user_chat") {
    خل ه = هذا._هويات(تحديث)
    خل مستخدم = ه["مستخدم"]
    خل محادثة = ه["محادثة"]
    اذا نطاق == "user" و مستخدم != عدم { ارجع "user:" + نص(مستخدم) }
    اذا نطاق == "chat" و محادثة != عدم { ارجع "chat:" + نص(محادثة) }
    اذا مستخدم != عدم و محادثة != عدم { ارجع "chat:" + نص(محادثة) + ":user:" + نص(مستخدم) }
    اذا مستخدم != عدم { ارجع "user:" + نص(مستخدم) }
    اذا محادثة != عدم { ارجع "chat:" + نص(محادثة) }
    ارجع "update:" + نص(تحديث.احصل("update_id", "unknown"))
  }
  احصل(تحديث, نطاق = "user_chat") {
    خل مفتاح = هذا._مفتاح(تحديث, نطاق)
    اذا هذا.السجلات.احصل(مفتاح, عدم) == عدم { هذا.السجلات[مفتاح] = {"حالة": عدم, "بيانات": {}} }
    ارجع هذا.السجلات[مفتاح]
  }
  حالة(تحديث, نطاق = "user_chat") { ارجع هذا.احصل(تحديث, نطاق).احصل("حالة", عدم) }
  اضبط_حالة(تحديث, حالة, نطاق = "user_chat") {
    هذا.احصل(تحديث, نطاق)["حالة"] = حالة
    هذا.احفظ()
    ارجع حالة
  }
  بيانات(تحديث, نطاق = "user_chat") { ارجع هذا.احصل(تحديث, نطاق).احصل("بيانات", {}) }
  اضبط_بيانات(تحديث, مفتاح, قيمة, نطاق = "user_chat") {
    هذا.بيانات(تحديث, نطاق)[مفتاح] = قيمة
    هذا.احفظ()
    ارجع قيمة
  }
  امسح(تحديث, نطاق = "user_chat") {
    هذا.السجلات.احذف(هذا._مفتاح(تحديث, نطاق))
    هذا.احفظ()
  }
  احفظ() {
    اذا هذا.المسار != "" { ملفات.اكتب(هذا.المسار, جيسون.ترميز(هذا.السجلات, 2) + "\n") }
    ارجع صح
  }
  وسيط() {
    خل المخزن = هذا
    ارجع دالة(تحديث, بوت, التالي) {
      تحديث["session"] = المخزن.احصل(تحديث)
      خل النتيجة = التالي()
      المخزن.احفظ()
      ارجع النتيجة
    }
  }
}

صنف حوار {
  بناء(مخزن, تحديث, نطاق = "user_chat") { هذا.مخزن = مخزن; هذا.تحديث = تحديث; هذا.نطاق = نطاق }
  حالة() { ارجع هذا.مخزن.حالة(هذا.تحديث, هذا.نطاق) }
  انتقل(اسم) { ارجع هذا.مخزن.اضبط_حالة(هذا.تحديث, اسم, هذا.نطاق) }
  بيانات() { ارجع هذا.مخزن.بيانات(هذا.تحديث, هذا.نطاق) }
  اضبط(مفتاح, قيمة) { ارجع هذا.مخزن.اضبط_بيانات(هذا.تحديث, مفتاح, قيمة, هذا.نطاق) }
  الغاء() { هذا.مخزن.امسح(هذا.تحديث, هذا.نطاق) }
}
دالة افتح_حوار(مخزن, تحديث, نطاق = "user_chat") { ارجع حوار(مخزن, تحديث, نطاق) }

صنف باني_لوحة {
  بناء(ضمني = صح, خيارات = {}) { هذا.ضمني = ضمني; هذا.خيارات = خيارات; هذا.الصفوف = [[]] }
  اضف(زر) {
    اذا طول(هذا.الصفوف) == 0 { هذا.الصفوف.اضف([]) }
    هذا.الصفوف[طول(هذا.الصفوف) - 1].اضف(زر)
    ارجع هذا
  }
  صف() {
    اذا طول(هذا.الصفوف) == 0 او طول(هذا.الصفوف[طول(هذا.الصفوف) - 1]) > 0 { هذا.الصفوف.اضف([]) }
    ارجع هذا
  }
  وزع(أحجام) {
    اذا طول(أحجام) == 0 { ارمي "أحجام توزيع اللوحة لا يمكن أن تكون فارغة" }
    خل ازرار = []
    لكل صف في هذا.الصفوف { لكل زر في صف { ازرار.اضف(زر) } }
    خل جديدة = []
    خل ف = 0
    خل د = 0
    طالما ف < طول(ازرار) {
      خل حجم = أحجام[د < طول(أحجام) ؟ د : طول(أحجام) - 1]
      اذا حجم <= 0 { ارمي "حجم صف اللوحة يجب أن يكون أكبر من صفر" }
      خل صف_جديد = []
      كرر حجم {
        اذا ف < طول(ازرار) { صف_جديد.اضف(ازرار[ف]); ف += 1 }
      }
      جديدة.اضف(صف_جديد)
      اذا د < طول(أحجام) - 1 { د += 1 }
    }
    هذا.الصفوف = جديدة
    ارجع هذا
  }
  صدّر() {
    اذا طول(هذا.الصفوف) > 0 و طول(هذا.الصفوف[طول(هذا.الصفوف) - 1]) == 0 { هذا.الصفوف.احذف(طول(هذا.الصفوف) - 1) }
    اذا هذا.ضمني { ارجع _دمج(هذا.خيارات, {"inline_keyboard": هذا.الصفوف}) }
    ارجع _دمج(هذا.خيارات, {"keyboard": هذا.الصفوف})
  }
}

