دالة امر(نص) {
  خل اجزاء = نص.نظف().قسم(" ")
  خل الرأس = اجزاء[0].قسم("@")[0]
  خل وسائط = []
  لكل ف في مدى(1, طول(اجزاء)) { وسائط.اضف(اجزاء[ف]) }
  ارجع {"اسم": الرأس.يبدأ_ب("/") ؟ الرأس.جزء(1) : الرأس, "وسائط": وسائط, "نص": نص}
}
دالة مرشح_خاص(رسالة) { ارجع رسالة.احصل("chat", {}).احصل("type", "") == "private" }
دالة مرشح_مجموعة(رسالة) { ارجع رسالة.احصل("chat", {}).احصل("type", "").يحتوي("group") }
دالة مرشح_مشرف(بوت, رسالة) {
  خل معرف_محادثة = رسالة.احصل("chat", {}).احصل("id", عدم)
  خل معرف_مستخدم = رسالة.احصل("from", {}).احصل("id", عدم)
  اذا معرف_محادثة == عدم او معرف_مستخدم == عدم { ارجع غلط }
  ارجع بوت.هل_مشرف(معرف_محادثة, معرف_مستخدم)
}
