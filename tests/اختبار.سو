استورد "نظام"
استورد "ملفات"
استورد "نمط"
استورد "جيسون"
استورد "../رئيسي" باسم تلجرام

دالة فشل(رسالة) { اطبع("فشل: " + رسالة); نظام.اخرج(1) }

اذا تلجرام.نسخة() != "1.0.0" { فشل("النسخة") }
خل cmd = تلجرام.امر("/start@mybot مرحبا 123")
اذا cmd.اسم != "start" { فشل("تحليل اسم الأمر") }
اذا طول(cmd.وسائط) != 2 او cmd.وسائط[0] != "مرحبا" { فشل("تحليل وسائط الأمر") }

خل لوحة = تلجرام.لوحة_ضمنية([[تلجرام.زر_ضمني("زر", {"callback_data": "x"})]])
اذا لوحة.inline_keyboard[0][0].text != "زر" { فشل("إنشاء زر") }
اذا لوحة.inline_keyboard[0][0].callback_data != "x" { فشل("بيانات callback") }

خل وصل = []
خل م = تلجرام.موجّه()
م.عند_امر("start", دالة(جزء, تحديث, بوت) { وصل.اضف("command") })
م.عند_نص(دالة(جزء, تحديث, بوت) { وصل.اضف("text") })
م.عند_زر(دالة(جزء, تحديث, بوت) { وصل.اضف("callback") })
م.معالجة({"update_id": 1, "message": {"text": "/start", "chat": {"id": 7}}}, عدم)
م.معالجة({"update_id": 2, "message": {"text": "مرحبا", "chat": {"id": 7}}}, عدم)
م.معالجة({"update_id": 3, "callback_query": {"id": "q", "data": "ok"}}, عدم)
اذا طول(وصل) != 4 { فشل("توجيه update types") }
اذا وصل[0] != "command" او وصل[1] != "text" او وصل[2] != "text" او وصل[3] != "callback" { فشل("ترتيب معالجات الموجّه") }

خل رد = تلجرام.لوحة_رد([[تلجرام.زر_رد("نعم")]], {"resize_keyboard": صح})
اذا رد.keyboard[0][0].text != "نعم" { فشل("لوحة الرد") }

خل لوحة_مبنية = تلجرام.باني_لوحة_ضمنية()
لوحة_مبنية.اضف(تلجرام.زر_رابط("أ", "https://example.com")).اضف(تلجرام.زر_استدعاء("ب", "b")).اضف(تلجرام.زر_نسخ("ج", "نص"))
لوحة_مبنية.وزع([2, 1])
خل markup = لوحة_مبنية.صدّر()
اذا طول(markup.inline_keyboard) != 2 او طول(markup.inline_keyboard[0]) != 2 { فشل("توزيع builder للوحة") }
اذا تلجرام.نتيجة_مقال("x", "العنوان", "النص").input_message_content.message_text != "النص" { فشل("نتيجة inline article") }

خل ترتيب = []
خل م2 = تلجرام.موجّه()
م2.استخدم(دالة(تحديث, بوت, التالي) { ترتيب.اضف("قبل"); التالي(); ترتيب.اضف("بعد") })
م2.عند_في_مجموعة(1, "message", دالة(رسالة) { ارجع صح }, دالة(رسالة, تحديث, بوت) { ترتيب.اضف("أول") })
م2.عند_في_مجموعة(1, "message", دالة(رسالة) { ارجع صح }, دالة(رسالة, تحديث, بوت) { ترتيب.اضف("ثان") })
م2.عند_في_مجموعة(2, "message", دالة(رسالة) { ارجع صح }, دالة(رسالة, تحديث, بوت) { ترتيب.اضف("مجموعة٢") })
م2.معالجة({"update_id": 4, "message": {"text": "abc123", "chat": {"id": 70}}}, عدم)
اذا طول(ترتيب) != 4 او ترتيب[0] != "قبل" او ترتيب[1] != "أول" او ترتيب[2] != "مجموعة٢" او ترتيب[3] != "بعد" { فشل("middleware وfirst-match groups") }

خل وصل_خطأ = غلط
خل م3 = تلجرام.موجّه()
م3.عند_خطأ(دالة(خطأ, تحديث, بوت) { وصل_خطأ = خطأ == "خطأ اختبار" })
م3.عند_كل(دالة(جزء, تحديث, بوت) { ارمي "خطأ اختبار" })
م3.معالجة({"update_id": 5}, عدم)
اذا ليس وصل_خطأ { فشل("error boundary") }

خل فلاتر = تلجرام.مرشح_و(دالة(ر) { ارجع ر.text != عدم }, دالة(ر) { ارجع تلجرام.مرشح_ليس(دالة(س) { ارجع س.text == "no" })(ر) })
اذا ليس فلاتر({"text": "yes"}) او فلاتر({"text": "no"}) { فشل("تركيب المرشحات") }
اذا ليس نمط.هل("^abc\\d+$", "abc123") { فشل("محرك regex") }

خل عدد_الطلبات = 0
خل ناقل_تجريبي = دالة(رابط, خيارات) {
  عدد_الطلبات += 1
  اذا ليس رابط.يحتوي("/botfake/sendMessage") { فشل("رابط الناقل المحقون") }
  اذا عدد_الطلبات == 1 { ارجع {"حالة": 429, "جسم": جيسون.ترميز({"ok": غلط, "error_code": 429, "description": "انتظر", "parameters": {"retry_after": 0}})} }
  ارجع {"حالة": 200, "جسم": جيسون.ترميز({"ok": صح, "result": {"message_id": 91}})}
}
خل بوت_وهمي = تلجرام.بوت("fake", {"ناقل": ناقل_تجريبي, "محاولات_429": 1})
اذا بوت_وهمي.طلب("sendMessage", {"chat_id": 3, "text": "test"}).message_id != 91 او عدد_الطلبات != 2 { فشل("إعادة المحاولة لـ429") }

خل مسار_جلسة = "/tmp/تلجرام_بوت_جلسات_اختبار.json"
اذا ملفات.موجود(مسار_جلسة) { ملفات.احذف(مسار_جلسة) }
خل مخزن = تلجرام.جلسات(مسار_جلسة)
خل تحديث_جلسة = {"update_id": 88, "message": {"from": {"id": 7}, "chat": {"id": 9}}}
مخزن.اضبط_حالة(تحديث_جلسة, "انتظار_الاسم")
مخزن.اضبط_بيانات(تحديث_جلسة, "الاسم", "سارة")
خل استرجاع = تلجرام.جلسات(مسار_جلسة)
اذا استرجاع.حالة(تحديث_جلسة) != "انتظار_الاسم" او استرجاع.بيانات(تحديث_جلسة).الاسم != "سارة" { فشل("حفظ واستعادة الجلسات") }
خل ح = تلجرام.افتح_حوار(استرجاع, تحديث_جلسة)
اذا ح.حالة() != "انتظار_الاسم" { فشل("واجهة الحوار") }
ح.الغاء()
اذا استرجاع.حالة(تحديث_جلسة) != عدم { فشل("إلغاء الحوار") }
ملفات.احذف(مسار_جلسة)

اطبع("نجح: API، التوجيه، middleware، لوحات المفاتيح، المرشحات، الجلسات والحوار")
